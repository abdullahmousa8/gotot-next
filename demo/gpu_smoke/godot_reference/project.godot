; Engine configuration file.
; GNE A/B Isolation - vanilla Godot reference project (NO GNE module).
; Twin of the 0.26-pre Country House for color-pipeline comparison.

config_version=5

[application]

config/name="GneHouseRef"
run/main_scene="res://main_026_house_ref.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
